# Shared
APP_ENV=development
LOG_LEVEL=info
TOROB_NETWORK_NAME=torob-net
TOROB_NETWORK_EXTERNAL=true

# PostgreSQL / Redis (apps read these names)
DATABASE_URL=postgres://flight:flight@localhost:5433/flight_services?sslmode=disable
REDIS_URL=redis://localhost:6380/5
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_FLIGHTS_INDEX=flight_offers
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RANKER_RABBITMQ_EXCHANGE=torob.flights
RANKER_RABBITMQ_QUEUE=torob.ranker
RANKER_RABBITMQ_ROUTING_KEY=flight.upsert
SEARCH_INDEXER_BATCH=100
SEARCH_INDEXER_POLL_INTERVAL=2s
SEARCH_INDEXER_RETRY_DELAY=30s
MIGRATIONS_PATH=migrations/001_flights_core.sql
MULTI_COLLECTOR_MIGRATION_PATH=migrations/002_multi_collector.sql

# flight-services-api
HTTP_ADDR=:8090
PNR_CACHE_PREFIX=airbar:pnr:v1
PNR_CACHE_TTL=10m

# Mahan PNR checker
MAHAN_PNR_ENDPOINT=https://www.mahanair.co.ir/api/Reservation/pnr
MAHAN_ORIGIN=https://www.mahanair.co.ir
MAHAN_REFERER=https://www.mahanair.co.ir/manage-booking
MAHAN_REQUEST_TIMEOUT=12s
MAHAN_RETRY_COUNT=1
AIRLINE_TIMEZONE=Asia/Tehran

# alibaba-collector
MAX_WORKERS=1
RATE_LIMIT_RPS=0.2
RATE_LIMIT_BURST=1
COLLECT_JOB_SPACING=5s
METRICS_ADDR=:9091

# tahagasht-collector
TAHAGASHT_MAX_WORKERS=1
TAHAGASHT_RATE_LIMIT_RPS=0.2
TAHAGASHT_RATE_LIMIT_BURST=1
TAHAGASHT_COLLECT_JOB_SPACING=5s
TAHAGASHT_UPSTREAM_POLL_INTERVAL=2500ms
TAHAGASHT_UPSTREAM_MAX_POLLS=20
TAHAGASHT_METRICS_ADDR=:9092

# snapp-collector
SNAPP_MAX_WORKERS=1
SNAPP_RATE_LIMIT_RPS=0.15
SNAPP_RATE_LIMIT_BURST=1
SNAPP_COLLECT_JOB_SPACING=8s
SNAPP_POLL_INTERVAL=2s
SNAPP_SEED_INTERVAL=3m
SNAPP_CIRCUIT_BREAKER_THRESHOLD=2
SNAPP_CIRCUIT_BREAKER_OPEN=15m
SNAPP_CABIN_TYPE=ECONOMY
SNAPP_METRICS_ADDR=:9093

# mrbilit-collector
MRBILIT_MAX_WORKERS=1
MRBILIT_RATE_LIMIT_RPS=0.15
MRBILIT_COLLECT_JOB_SPACING=8s
MRBILIT_METRICS_ADDR=:9094

# safarmarket-collector
SAFARMARKET_MAX_WORKERS=1
SAFARMARKET_RATE_LIMIT_RPS=0.15
SAFARMARKET_COLLECT_JOB_SPACING=8s
SAFARMARKET_METRICS_ADDR=:9095

# flytoday-collector
FLYTODAY_MAX_WORKERS=1
FLYTODAY_RATE_LIMIT_RPS=0.05
FLYTODAY_COLLECT_JOB_SPACING=15s
FLYTODAY_SEED_INTERVAL=5m
FLYTODAY_BASE_URL=https://www.flytoday.ir/api/gateway/V1
FLYTODAY_REFERER=https://www.flytoday.ir
FLYTODAY_ORIGIN_HEADER=https://www.flytoday.ir
FLYTODAY_REQUEST_SOURCE=www.flytoday.ir
FLYTODAY_COOKIE=
FLYTODAY_HTTP_TIMEOUT=90s
FLYTODAY_METRICS_ADDR=:9096

# trip-collector
TRIP_MAX_WORKERS=1
TRIP_RATE_LIMIT_RPS=0.15
TRIP_COLLECT_JOB_SPACING=8s
TRIP_BASE_URL=https://gateway-v2.trip.ir/api
TRIP_SITE_URL=https://www.trip.ir
TRIP_COOKIE=
TRIP_HTTP_TIMEOUT=90s
TRIP_METRICS_ADDR=:9097

# docker compose local profile
POSTGRES_PASSWORD=flight
POSTGRES_DB=flight_services
POSTGRES_USER=flight
