# Copy to .env and adjust values as needed.
# Collector identity
COLLECTOR_NAME=mrbilit

# PostgreSQL connection
DATABASE_URL=postgres://postgres:alibaba@localhost:5433/flights?sslmode=disable

# Migration paths (local dev; Docker uses /app/migrations/)
MIGRATIONS_PATH=migrations/001_flights_core.sql
MULTI_COLLECTOR_MIGRATION_PATH=migrations/002_multi_collector.sql

# Runtime
APP_ENV=development
LOG_LEVEL=info

# Worker settings
MAX_WORKERS=1
RATE_LIMIT_RPS=0.15
RATE_LIMIT_BURST=1
POLL_INTERVAL=2s
SEED_INTERVAL=3m
JOB_STALE_AFTER=15m
COLLECT_JOB_SPACING=8s
HTTP_TIMEOUT=60s
CIRCUIT_BREAKER_THRESHOLD=2
CIRCUIT_BREAKER_OPEN=15m

# Search defaults
ADULT=1
FLIGHT_CLASS=Economy

# Health / metrics server
METRICS_ADDR=:9094

# Site-specific settings
MRBILIT_BASE_URL=https://flight.atighgasht.com
