TOROB_NETWORK_NAME=torob-net
TOROB_NETWORK_EXTERNAL=true
RANKER_DB_USER=ranker
RANKER_DB_PASSWORD=ranker
RANKER_DB_NAME=ranker_db
RABBITMQ_USER=torob
RABBITMQ_PASSWORD=torob
RANKER_INTERVAL=10s
# Host processes. Compose builds these itself from the variables above.
RANKER_DATABASE_URL=postgres://ranker:ranker@127.0.0.1:5433/ranker_db?sslmode=disable
RABBITMQ_URL=amqp://torob:torob@127.0.0.1:5672/
